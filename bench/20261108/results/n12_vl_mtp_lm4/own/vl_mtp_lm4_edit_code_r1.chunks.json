"], [18949.33, " strings line up with"], [18967.42, " the left\n   "], [18985.41, " edge of the display"], [19003.11, ", while still presenting"], [19021.21, " them in the source"], [19039.55, " code\n    in"], [19057.1, " indented form."], [19075.02, "\n\n    Note that"], [19093.16, " tabs and spaces are"], [19111.05, " both treated as whitespace"], [19129.22, ", but they\n"], [19147.39, "    are not equal"], [19165.23, ": the lines \""], [19183.25, "  hello\" and"], [19201.38, " \"\\\\thello\""], [19219.33, " are\n    considered"], [19237.24, " to have no common"], [19255.28, " leading whitespace.\n\n"], [19273.15, "    Entirely blank"], [19290.99, " lines are normalized to"], [19308.79, " a newline character."], [19326.65, "\n    \"\"\"\n"], [19344.34, "    # Look for"], [19362.25, " the longest leading string"], [19380.49, " of spaces and tabs"], [19398.18, " common to\n   "], [19416.19, " # all lines."], [19434.13, "\n    common_margin"], [19452.05, " = None\n   "], [19470.06, " text = _wh"], [19488.14, "itespace_only_re.sub"], [19506.12, "('', text)\n"], [19524.02, "    indents ="], [19541.87, " _leading_whitespace_re"], [19559.84, ".findall(text)\n"], [19577.94, "    for indent in"], [19596.33, " indents:\n"], [19614.16, "        if common_margin"], [19632.58, " is None:\n"], [19650.51, "            common_margin ="], [19668.67, " indent\n\n        #"], [19686.64, " Current line more deeply"], [19704.62, " indented than previous"], [19722.35, " winner:\n       "], [19740.53, " # no change ("], [19758.31, "previous winner is still"], [19776.49, " on top).\n"], [19794.82, "        elif indent.startswith"], [19812.39, "(common_margin):\n"], [19830.98, "            pass\n\n       "], [19848.73, " # Current line consistent"], [19866.67, " with and no deeper"], [19884.5, " than previous winner:"], [19902.27, "\n        # it"], [19920.2, "'s the new winner"], [19938.13, ".\n        elif"], [19956.11, " common_margin.startswith(indent"], [19973.94, "):\n            common"], [19992.09, "_margin = indent\n\n"], [20009.89, "        # Find the"], [20028.35, " largest common whitespace between"], [20045.99, " current line and previous"], [20063.96, "\n        # winner"], [20082.04, ".\n        else"], [20100.11, ":\n            for"], [20118.17, " i, (x"], [20136.35, ", y) in"], [20154.33, " enumerate(zip(common"], [20172.48, "_margin, indent)):"], [20190.25, "\n                if x"], [20208.41, " != y:\n"], [20226.52, "                    common_margin ="], [20244.15, " common_margin[:i"], [20262.17, "]\n                    break"], [20280.33, "\n\n    # sanity"], [20298.36, " check (testing/debug"], [20316.25, "ging only)\n"], [20334.5, "    if 0"], [20352.18, " and common_margin:"], [20369.98, "\n        for line"], [20388.25, " in text.split(\"\\"], [20406.28, "n\"):\n           "], [20424.28, " assert not line or"], [20442.32, " line.startswith(common_margin"], [20460.32, "), \\\n                  "], [20478.5, " \"line = %"], [20496.33, "r, margin ="], [20513.92, " %r\" %"], [20532.03, " (line, common"], [20550.01, "_margin)\n\n   "], [20568.08, " if common_margin:"], [20586.12, "\n        text ="], [20603.88, " re.sub(r'"], [20622.16, "(?m)^'"], [20640.17, " + common_margin,"], [20658.28, " '', text)\n"], [20676.1, "    return text\n\n\n"], [20694.14, "def indent(text,"], [20712.31, " prefix, predicate=None"], [20730.35, "):\n    \"\"\""], [20749.86, "Adds 'prefix'"], [20767.51, " to the beginning of"], [20786.84, " selected lines in '"], [20806.19, "text'.\n\n   "], [20823.44, " If 'predicate'"], [20843.83, " is provided, '"], [20861.49, "prefix' will only"], [20879.7, " be added to the"], [20897.7, " lines\n    where"], [20916.15, " 'predicate(line)'"], [20934.49, " is True. If"], [20953.33, " 'predicate' is"], [20974.07, " not provided,\n"], [20993.26, "    it will default"], [21012.09, " to adding 'prefix"], [21032.1, "' to all non"], [21050.03, "-empty lines that do"], [21068.77, " not\n    consist"], [21086.79, " solely of whitespace characters"], [21105.27, ".\n    \"\"\""], [21124.27, "\n    if predicate"], [21142.08, " is None:\n"], [21161.18, "        def predicate(line"], [21178.78, "):\n            return"], [21198.04, " line.strip()\n\n"], [21215.81, "    def prefixed"], [21234.65, "_lines():\n       "], [21252.39, " for line in text"], [21271.46, ".splitlines(True):"], [21289.52, "\n            yield ("], [21307.72, "prefix + line if"], [21326.43, " predicate(line) else"], [21345.05, " line)\n   "], [21363.53, " return ''.join(pref"], [21381.6, "ixed_lines())\n\n\n"], [21400.76, "if __name__"], [21418.88, " == \"__main__"], [21437.48, "\":\n    #"], [21455.59, "print dedent(\"\\"], [21473.49, "tfoo\\n\\t"], [21492.47, "bar\")\n   "], [21510.36, " #print dedent"], [21529.38, "(\"  \\th"], [21547.39, "ello there\\n "], [21566.53, " \\t  how"], [21585.49, " are you?\")"], [21603.32, "\n    print(d"], [21622.23, "edent(\"Hello"], [21641.88, " there.\\n "], [21660.41, " This is indented"], [21679.63, ".\"))"]]}