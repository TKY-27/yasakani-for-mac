27, " behaviour.\n   "], [20145.49, " \"\"\"\n    w"], [20164.56, " = TextWrapper(width"], [20183.93, "=width, **"], [20202.67, "kwargs)\n   "], [20222.5, " return w.fill(text"], [20241.31, ")\n\ndef shorten"], [20260.43, "(text, width,"], [20280.5, " **kwargs):\n"], [20298.79, "    \"\"\"Collapse and"], [20318.16, " truncate the given text"], [20337.37, " to fit in the"], [20356.59, " given width.\n\n"], [20375.92, "    The text first"], [20394.64, " has its whitespace collapsed"], [20413.98, ".  If it"], [20432.69, " then fits in\n"], [20452.35, "    the *width"], [20471.52, "*, it is returned"], [20490.3, " as is. "], [20509.48, " Otherwise, as many"], [20528.12, " words\n    as"], [20547.41, " possible are joined and"], [20566.21, " then the placeholder is"], [20585.7, " appended::\n\n       "], [20605.03, " >>> textwrap.short"], [20624.83, "en(\"Hello "], [20643.86, " world!\", width="], [20662.37, "12)\n"], [20681.99, "        'Hello world"], [20700.86, "!'\n        >>>"], [20719.98, " textwrap.shorten"], [20739.0, "(\"Hello  world"], [20758.14, "!\", width=1"], [20777.46, "1)\n       "], [20796.27, " 'Hello [...]'"], [20815.56, "\n    \"\"\"\n"], [20834.35, "    w = Text"], [20854.09, "Wrapper(width=width"], [20873.15, ", max"], [20891.75, "_lines=1,"], [20911.22, " **kwargs)\n"], [20929.72, "    return w.fill"], [20948.95, "(' '.join(text"], [20967.89, ".strip().split()))"], [20987.28, "\n\n\n# -- Lo"], [21006.26, "osely related functionality"], [21025.02, " -------------------------------------\n\n_whitespace"], [21043.9, "_only_re = re"], [21062.71, ".compile('^[ \\"], [21082.14, "t]+$', re"], [21101.66, ".MULTILINE)\n"], [21120.89, "_leading_whitespace_re"], [21140.48, " = re.compile('("], [21160.52, "^[ \\t]*"], [21180.27, ")(?:[^ \\"], [21200.07, "t\\n])',"], [21219.87, " re.MULTILINE)"], [21239.18, "\n\ndef dedent"], [21259.52, "(text):\n   "], [21278.73, " \"\"\"Remove any common"], [21298.02, " leading whitespace from every"], [21318.5, " line in `text"], [21337.98, "`.\n\n    This"], [21357.84, " can be used to"], [21378.76, " make triple-quoted"], [21397.82, " strings line up with"], [21418.47, " the left\n   "], [21437.34, " edge of the display"], [21456.91, ", while still presenting"], [21476.86, " them in the source"], [21496.66, " code\n    in"], [21516.24, " indented form."], [21535.6, "\n\n    Note that"], [21555.02, " tabs and spaces are"], [21574.55, " both treated as whitespace"], [21594.25, ", but they\n"], [21613.67, "    are not equal"], [21632.85, ": the lines \""], [21652.65, "  hello\" and"], [21671.9, " \"\\\\thello\""], [21691.43, " are\n    considered"], [21710.76, " to have no common"], [21730.61, " leading whitespace.\n\n"], [21749.9, "    Entirely blank"], [21769.22, " lines are normalized to"], [21789.66, " a newline character."], [21809.73, "\n    \"\"\"\n"], [21829.0, "    # Look for"], [21849.48, " the longest leading string"], [21869.53, " of spaces and tabs"], [21889.84, " common to\n   "], [21910.08, " # all lines."], [21929.87, "\n    common_margin"], [21949.58, " = None\n   "], [21969.48, " text = _wh"], [21989.01, "itespace_only_re.sub"], [22009.06, "('', text)\n"], [22028.23, "    indents ="], [22048.07, " _leading_whitespace_re"], [22066.94, ".findall(text)\n"], [22086.84, "    for indent in"], [22107.36, " indents:\n"], [22126.4, "        if common_margin"], [22146.12, " is None:\n"], [22164.97, "            common_margin ="], [22184.85, " indent\n\n        #"], [22204.11, " Current line more deeply"], [22223.61, " indented than previous"], [22243.17, " winner:\n       "], [22262.49, " # no change ("], [22281.94, "previous winner is still"], [22301.23, " on top).\n"], [22320.89, "        elif indent.startswith"], [22340.13, "(common_margin):\n"], [22359.48, "            pass\n\n       "], [22379.5, " # Current line consistent"], [22398.53, " with and no deeper"], [22418.32, " than previous winner:"], [22437.38, "\n        # it"], [22457.14, "'s the new winner"], [22476.68, ".\n        elif"], [22495.73, " common_margin.startswith(indent"], [22515.47, "):\n            common"], [22534.43, "_margin = indent\n\n"], [22554.36, "        # Find the"], [22573.34, " largest common whitespace between"], [22593.34, " current line and previous"], [22613.26, "\n        # winner"], [22632.37, ".\n        else"], [22651.68, ":\n            for"], [22671.81, " i, (x"], [22690.87, ", y) in"], [22710.29, " enumerate(zip(common"], [22729.42, "_margin, indent)):"], [22749.34, "\n                if x"], [22768.49, " != y:\n"], [22788.03, "                    common_margin ="], [22807.85, " common_margin[:i"], [22827.22, "]\n                    break"], [22847.01, "\n\n    # sanity"], [22865.89, " check (testing/debug"], [22885.74, "ging only)\n"], [22905.05, "    if 0"], [22924.55, " and common_margin:"], [22944.41, "\n        for line"], [22963.52, " in text.split(\"\\"], [22982.87, "n\"):\n           "], [23002.24, " assert not line or"], [23021.93, " line.startswith(common_margin"], [23040.99, "), \\\n                  "], [23060.64, " \"line = %"], [23080.91, "r, margin ="], [23099.85, " %r\" %"], [23120.0, " (line, common"], [23139.11, "_margin)\n\n   "], [23158.79, " if common_margin:"], [23178.64, "\n        text ="], [23197.97, " re.sub(r'"], [23217.53, "(?m)^'"], [23236.66, " + common_margin,"], [23256.59, " '', text)\n"], [23276.27, "    return text\n\n\n"], [23295.23, "def indent(text,"], [23315.35, " prefix, predicate=None"], [23334.46, "):\n    \"\"\""], [23355.17, "Adds 'prefix'"], [23375.48, " to the beginning of"], [23394.75, " selected lines in '"], [23414.57, "text'.\n\n   "], [23433.71, " If 'predicate'"], [23453.53, " is provided, '"], [23473.18, "prefix' will only"], [23492.35, " be added to the"], [23511.81, " lines\n    where"], [23530.93, " 'predicate(line)'"], [23550.96, " is True. If"], [23569.92, " 'predicate' is"], [23589.43, " not provided,\n"], [23609.67, "    it will default"], [23628.67, " to adding 'prefix"], [23648.49, "' to all non"], [23667.64, "-empty lines that do"], [23687.57, " not\n    consist"], [23706.64, " solely of whitespace characters"], [23726.09, ".\n    \"\"\""], [23745.49, "\n    if predicate"], [23764.53, " is None:\n"], [23784.62, "        def predicate(line"], [23804.03, "):\n            return"], [23823.68, " line.strip()\n\n"], [23843.77, "    def prefixed_lines"], [23862.63, "():\n        for"], [23882.39, " line in text.split"], [23901.54, "lines(True):\n"], [23921.23, "            yield (prefix"], [23940.35, " + line if predicate"], [23960.09, "(line) else line"], [23979.68, ")\n    return"], [23998.73, " ''.join(prefixed"], [24019.36, "_lines())\n\n\nif"], [24038.57, " __name__ =="], [24058.28, " \"__main__\":"], [24078.17, "\n    #print"], [24097.32, " dedent(\"\\t"], [24117.28, "foo\\n\\tbar"], [24136.76, "\")\n    #"], [24156.45, "print dedent(\""], [24176.07, "  \\thello"], [24195.78, " there\\n  \\"], [24215.35, "t  how are"], [24234.99, " you?\")\n"], [24254.52, "    print(ded"], [24274.04, "ent(\"Hello there"], [24293.25, ".\\n  This"], [24313.29, " is indented.\""], [24332.84, "))"]]}