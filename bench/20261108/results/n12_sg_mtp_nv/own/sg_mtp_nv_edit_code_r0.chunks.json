ll probably have"], [2075.12, " to override _wrap"], [2095.1, "_chunks().\n\n   "], [2116.52, " Several instance attributes control"], [2137.33, " various aspects of wrapping"], [2158.38, ":\n      width"], [2179.78, " (default: "], [2200.71, "70)\n"], [2222.16, "        the maximum width"], [2242.57, " of wrapped lines ("], [2263.3, "unless break_long_words"], [2284.44, "\n        is false"], [2305.04, ")\n      initial"], [2326.77, "_indent (default:"], [2347.69, " \"\")\n        string"], [2369.11, " that will be prep"], [2389.89, "ended to the first"], [2411.03, " line of wrapped\n"], [2431.73, "        output. "], [2453.21, " Counts towards the line"], [2474.53, "'s width.\n"], [2495.19, "      subsequent_indent ("], [2516.85, "default: \"\")\n"], [2537.39, "        string that will"], [2558.88, " be prepended to"], [2580.27, " all lines save the"], [2602.19, " first\n        of"], [2623.05, " wrapped output; also"], [2644.64, " counts towards each line"], [2665.3, "'s width.\n"], [2686.66, "      expand_tabs ("], [2708.27, "default: true)"], [2728.6, "\n        Expand tabs"], [2750.5, " in input text to"], [2771.1, " spaces before further processing"], [2792.0, ".\n        Each"], [2812.96, " tab will become "], [2834.32, "0 .. 'tab"], [2855.18, "size' spaces,"], [2876.72, " depending on its position"], [2898.06, "\n        in its"], [2918.94, " line.  If"], [2940.14, " false, each tab"], [2960.82, " is treated as a"], [2982.04, " single character.\n"], [3002.87, "      tabsize ("], [3024.26, "default: 8"], [3046.64, ")\n        Expand"], [3065.47, " tabs in input text"], [3084.98, " to 0 .."], [3104.81, " 'tabsize'"], [3124.76, " spaces, unless\n"], [3144.87, "        'expand_tabs"], [3164.12, "' is false."], [3183.76, "\n      replace_whitespace"], [3203.56, " (default: true"], [3223.44, ")\n        Replace"], [3243.19, " all whitespace characters in"], [3262.76, " the input text by"], [3282.72, " spaces\n        after"], [3302.35, " tab expansion. "], [3322