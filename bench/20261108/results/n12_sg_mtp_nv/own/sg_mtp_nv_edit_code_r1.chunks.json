, [1530.29, " to override _wrap"], [1549.7, "_chunks().\n\n   "], [1568.19, " Several instance attributes control"], [1587.4, " various aspects of wrapping"], [1605.89, ":\n      width"], [1625.18, " (default: "], [1644.69, "70)\n"], [1663.46, "        the maximum width"], [1681.92, " of wrapped lines ("], [1700.79, "unless break_long_words"], [1720.17, "\n        is false"], [1738.76, ")\n      initial"], [1758.02, "_indent (default:"], [1776.55, " \"\")\n        string"], [1795.41, " that will be prep"], [1814.8, "ended to the first"], [1833.3, " line of wrapped\n"], [1852.41, "        output. "], [1871.23, " Counts towards the line"], [1890.3, "'s width.\n"], [1908.94, "      subsequent_indent ("], [1928.61, "default: \"\")\n"], [1947.27, "        string that will"], [1965.77, " be prepended to"], [1985.18, " all lines save the"], [2003.74, " first\n        of"], [2023.06, " wrapped output; also"], [2041.71, " counts towards each line"], [2060.78, "'s width.\n"], [2080.76, "      expand_tabs ("], [2099.41, "default: true)"], [2118.52, "\n        Expand tabs"], [2137.02, " in input text to"], [2156.47, " spaces before further processing"], [2174.89, ".\n        Each"], [2194.22, " tab will become "], [2212.82, "0 .. 'tab"], [2232.03, "size' spaces,"], [2251.36, " depending on its position"], [2270.02, "\n        in its"], [2289.13, " line.  If"], [2307.46, " false, each tab"], [2327.04, " is treated as a"], [2346.52, " single character.\n"], [2365.03, "      tabsize ("], [2384.24, "default: 8"], [2402.8, ")\n        Expand"], [2421.9, " tabs in input text"], [2440.76, " to 0 .."], [2459.84, " 'tabsize'"], [2479.21, " spaces, unless\n"], [2498.1, "        'expand_tabs"], [2517.01, "' is false."], [2535.35, "\n      replace_whitespace"], [2554.54, " (default: true"], [2573.24, ")\n        Replace"], [2592.28, " all whitespace characters in"], [2611.0, " the input text by"], [2630.16, " spaces\n        after"], [2649.32, " tab expansion. "], [2668.06, " Note that if expand"], [2687.21, "_tabs is false and"], [2705.58, "\n        replace_whitespace"], [2725.09, " is true, every"], [2744.31, " tab will be converted"], [2762.97, " to a\n"], [2782.28, "        single space!"], [2800.96, "\n      fix_sentence"], [2820.0, "_endings (default"], [2839.04, ": false)\n"], [2858.32, "        Ensure that sentence"], [2876.77, "-ending punctuation is always"], [2896.23, " followed\n        by"], [2915.3, " two spaces. "], [2933.78, " Off by default because"], [2953.25, " the algorithm is\n"], [2971.67, "        (unavoid"], [2991.52, "ably) imperfect."], [3010.37, "\n      break_long"], [3029.39, "_words (default:"], [3048.4, " true)\n       "], [3068.34, " Break words longer than"], [3087.61, " 'width'. "], [3106.14, " If false, those"], [3125.61, " words will not\n"], [3144.74, "        be broken,"], [3163.32, " and some lines might"], [3182.39, " be longer than '"], [3200.91, "width'.\n     "], [3220.01, " break_on_hy"], [3239.65, "phens (default"], [3259.56, ": true)\n"], [3279.23, "        Allow breaking hy"], [3298.6, "phenated words."], [3317.43, " If true, wrapping"], [3336.21, " will occur\n       "], [3356.36, " preferably on whitespaces"], [3375.34, " and right after hy"], [3394.6, "phens part of"], [3414.84, "\n        compound words"], [3433.37, ".\n      drop"], [3453.19, "_whitespace (default:"], [3472.55, " true)\n       "], [3491.99, " Drop leading and trailing"], [3511.63, " whitespace from lines."], [3531.44, "\n      max_lines"], [3550.64, " (default: None"], [3570.34, ")\n        Tr"], [3590.73, "uncate wrapped lines."], [3609.88, "\n      placeholder ("], [3629.26, "default: ' [...]"], [3648.63, "')\n        Append"], [3667.99, " to the last line"], [3687.66, " of truncated text."], [3706.38, "\n    \"\"\"\n\n"], [3727.08, "    unicode_whitespace_trans"], [3746.37, " = dict.fromkeys"], [3765.55, "(map(ord, _"], [3785.43, "whitespace), ord"], [3805.05, "(' '))\n\n"], [3824.5, "    # This funky"], [3844.58, " little regex