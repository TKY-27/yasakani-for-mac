"\"\"\n    w"], [19299.18, " = TextWrapper(width"], [19321.04, "=width, **"], [19342.71, "kwargs)\n   "], [19364.98, " return w.fill(text"], [19387.32, ")\n\ndef shorten"], [19408.61, "(text, width,"], [19430.19, " **kwargs):\n"], [19452.08, "    \"\"\"Collapse and"], [19473.84, " truncate the given text"], [19495.64, " to fit in the"], [19518.16, " given width.\n\n"], [19539.46, "    The text first"], [19559.46, " has its whitespace collapsed"], [19579.53, ".  If it"], [19599.17, " then fits in\n"], [19619.74, "    the *width"], [19639.31, "*, it is returned"], [19659.22, " as is. "], [19679.17, " Otherwise, as many"], [19698.97, " words\n    as"], [19718.22, " possible are joined and"], [19737.96, " then the placeholder is"], [19757.98, " appended::\n\n       "], [19777.6, " >>> textwrap.short"], [19798.49, "en(\"Hello "], [19818.08, " world!\", width="], [19837.53, "12)\n"], [19857.63, "        'Hello world"], [19876.88, "!'\n        >>>"], [19896.98, " textwrap.shorten"], [19916.88, "(\"Hello  world"], [19935.87, "!\", width=1"], [19956.61, "1)\n       "], [19975.58, " 'Hello [...]'"], [19995.25, "\n    \"\"\"\n"], [20015.42, "    w = Text"], [20035.03, "Wrapper(width=width"], [20054.64, ", max"], [20074.03, "_lines=1,"], [20094.21, " **kwargs)\n"], [20114.18, "    return w.fill"], [20132.99, "(' '.join(text"], [20152.67, ".strip().split()))"], [20171.22, "\n\n\n# -- Lo"], [20190.63, "osely related functionality"], [20210.28, " -------------------------------------\n\n_whitespace"], [20229.58, "_only_re = re"], [20248.92, ".compile('^[ \\"], [20267.67, "t]+$', re"], [20287.04, ".MULTILINE)\n"], [20306.03, "_leading_whitespace_re"], [20325.81, " = re.compile('("], [20345.07, "^[ \\t]*"], [20363.83, ")(?:[^ \\"], [20383.19, "t\\n])',"], [20401.99, " re.MULTILINE)"], [20421.26, "\n\ndef dedent"], [20440.21, "(text):\n   "], [20459.31, " \"\"\"Remove any common"], [20478.1, " leading whitespace from every"], [20497.27, " line in `text"], [20516.8, "`.\n\n    This"],