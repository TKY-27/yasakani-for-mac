ommon_margin.startswith(indent"], [21708.15, "):\n            common"], [21729.22, "_margin = indent\n\n"], [21749.96, "        # Find the"], [21770.63, " largest common whitespace between"], [21791.73, " current line and previous"], [21812.45, "\n        # winner"], [21833.22, ".\n        else"], [21853.57, ":\n            for"], [21874.96, " i, (x"], [21895.39, ", y) in"], [21916.27, " enumerate(zip(common"], [21937.19, "_margin, indent)):"], [21957.44, "\n                if x"], [21978.12, " != y:\n"], [21999.49, "                    common_margin ="], [22020.06, " common_margin[:i"], [22040.01, "]\n                    break"], [22061.0, "\n\n    # sanity"], [22081.12, " check (testing/debug"], [22102.24, "ging only)\n"], [22122.43, "    if 0"], [22143.27, " and common_margin:"], [22163.18, "\n        for line"], [22184.54, " in text.split(\"\\"], [22204.75, "n\"):\n           "], [22225.41, " assert not line or"], [22245.74, " line.startswith(common_margin"], [22266.15, "), \\\n                  "], [22286.95, " \"line = %"], [22307.98, "r, margin ="], [22328.05, " %r\" %"], [22348.29, " (line, common"], [22369.16, "_margin)\n\n   "], [22389.51, " if common_margin:"], [22410.18, "\n        text ="], [22430.64, " re.sub(r'"], [22451.16, "(?m)^'"], [22471.57, " + common_margin,"], [22492.58, " '', text)\n"], [22513.35, "    return text\n\n\n"], [22533.49, "def indent(text,"], [22554.27, " prefix, predicate=None"], [22575.05, "):\n    \"\"\""], [22596.11, "Adds 'prefix'"], [22616.36, " to the beginning of"], [22637.25, " selected lines in '"], [22657.32, "text'.\n\n   "], [22677.72, " If 'predicate'"], [22698.28, " is provided, '"], [22718.92, "prefix' will only"], [22739.73, " be added to the"], [22760.36, " lines\n    where"], [22781.07, " 'predicate(line)'"], [22802.11, " is True. If"], [22822.27, " 'predicate' is"], [22842.41, " not provided,\n"], [22862.53, "    it will default"], [22882.89, " to adding 'prefix"], [22903.61, "' to all non"], [22924.28, "-empty lines that do"], [22945.53, " not\n    consist"], [22965.77, " solely of whitespace characters"], [22986.99, ".\n    \"\"\""], [23007.38, "\n    if predicate"], [23028.09, " is None:\n"], [23049.19, "        def predicate(line"], [23069.5, "):\n            return"], [23090.14, " line.strip()\n\n"], [23110.74, "    def prefixed_lines"], [23131.63, "():\n        for"], [23151.52, " line in text.split"], [23172.29, "lines(True):\n"], [23192.59, "            yield (prefix"], [23213.01, " + line if predicate"], [23233.98, "(line) else line"], [23254.78, ")\n    return"], [23275.62, " ''.join(prefixed"], [23296.7, "_lines())\n\n\nif"], [23316.71, " __name__ =="], [23337.3, " \"__main__\":"], [23357.67, "\n    #print"], [23378.45, " dedent(\"\\t"], [23399.16, "foo\\n\\tbar"], [23420.56, "\")\n    #"], [23440.59, "print dedent(\""], [23461.46, "  \\thello"], [23481.67, " there\\n  \\"], [23502.55, "t  how are"], [23522.69, " you?\")\n"], [23544.36, "    print(ded"], [23564.12, "ent(\"Hello there"], [23585.38, ".\\n  This"], [23605.45, " is indented.\""], [23626.65, "))"]]}