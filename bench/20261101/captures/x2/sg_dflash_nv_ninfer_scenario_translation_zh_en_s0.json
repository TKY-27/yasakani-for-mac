etween"], [0.690017, "content", " host preparation, visual preprocessing, text pre"], [0.711216, "content", "fill, and the first output token;"], [0.732973, "content", " file reading"], [0.754163, "content", " or model loading must not be mixed"], [0.775781, "content", " into throughput measurements.\n\n**Part "], [0.797728, "content", "3: Decoding**\nStandard"], [0.819261, "content", " decoding commits one token per round"], [0.840676, "content", ", while speculative decoding can verify multiple candidates"], [0.862032, "content", " and commit"], [0.883723, "content", " a contiguous"], [0.905556, "content", " prefix. Regardless of how many candidates are"], [0.926797, "content", " accepted, the public"], [0.948362, "content", " output, KV cache, loop"], [0.969828, "content", " state, and counters must correspond"], [0.99158, "content", " to the same committed position;"], [1.012872, "content", " no partially"], [1.034565, "content", " updated state may"], [1.055916, "content", " be left behind.\n\n**Part "], [1.077055, "content", "4: Long Context**\nAs"], [1.098822, "content", " context grows, latency"], [1.120282, "content", " is jointly"], [1.142301, "content", " determined by fixed weight reads"], [1.163536, "content", " and the"], [1.184923, "content", " ever"], [1.206533, "content", "-growing attention cache reads. Reports"], [1.22812, "content", " should provide"], [1.249253, "content", " absolute"], [1.270685, "content", " speed, relative retention rate"], [1.291966, "content", ", and actual"], [1.313483, "content", " prompt token count"], [1.335261, "content", ", and record"], [1.356915, "content", " cache format, maximum capacity, sampler,"], [1.378277, "content", " and graph execution state.\n\n**Part"], [1.399636, "content", " 5: Reproducibility**\n"], [1.42098, "content", "Stable inputs must be saved as the"], [1.442609, "content", " actual message files sent,"], [1.464174, "content", " with"], [1.48574, "content", " source and token count recorded. Formal"], [1.507678, "content", " runs must"], [1.529159, "content", " not temporarily download web pages, randomly select"], [1.550351, "content", " questions"], [1.571868, "content", ", or remove"], [1.593145, "content", " slower samples. Every"], [1.614698, "content", " number must be traceable back"], [1.636258, "content", " to a specific model, command, input"], [1.657548, "content", ", and service log"], [1.679199, "content", ".\n\n**Part 6: Result"], [1.700635, "content", " Interpretation**\nA single fastest isolated"], [1.722246, "content", " run does"], [1.744656, "content", " not prove stable performance, and a single"], [1.765913, "content", " high acceptance-rate"], [1.787853, "content", " text does not represent all output scenarios."], [1.808875, "content", " Code, narrative, translation, and structured"], [1.830421, "content", " content have different token distributions and"], [1.851964, "content", " should be presented separately rather"], [1.873739, "content", " than mixed"], [1.895284, "content", " into a meaningless overall average."], [1.916766, "content", "\n\n---\n\n### Chinese-English Gloss"], [1.938454, "content", "ary\n\n| Chinese Term | English Term"], [1.960115, "content", " |\n"], [1.981539, "content", "| :--- | :--- |\n"], [2.002989, "content", "| 运行边界 | Operational Bound"], [2.024392, "content", "aries |\n| 活动"], [2.045945, "content", "请求 | Active Request |\n| "], [2.067216, "content", "模型状态 | Model State |\n|"], [2.088736, "content", " 执行程序 | Execution Thread /"], [2.110153, "content", " Program |\n| 单卡本地"], [2.132041, "content", "推理 | Single-GPU Local Inference"], [2.153211, "content", " |\n| 内存规划器 |"], [2.174689, "content", " Memory Planner |\n| 工作区"], [2.196334, "content", " | Workspace |\n| 图"], [2.21779, "content", "执行地址 | Graph Execution Address"], [2.23935, "content", " |\n| 状态转换"], [2.260946, "content", " | State Transition |\n| 预"], [2.28238, "content", "填充 | Prefill |\n| "], [2.303809, "content", "模板渲染 | Template Rendering |\n|