isual preprocessing, text"], [0.716209, "content", " prefill, and the first output token"], [0.734532, "content", "; file"], [0.752836, "content", " reading"], [0.771738, "content", " or model loading must not be mixed"], [0.79011, "content", " into"], [0.808739, "content", " throughput metrics.\n\n**Part 3"], [0.827428, "content", ": Decoding**\nStandard"], [0.845784, "content", " decoding commits one token per round"], [0.864448, "content", ","], [0.882749, "content", " while speculative decoding can verify multiple candidates and"], [0.901494, "content", " commit a contiguous"], [0.919776, "content", " prefix. Regardless of how many candidates are"], [0.938261, "content", " accepted, the public output, KV cache"], [0.957798, "content", ", loop"], [0.976152, "content", " state, and counters must all correspond to"], [0.994667, "content", " the same committed position; no"], [1.013148, "content", " partially updated state may"], [1.032719, "content", " be left behind.\n\n**Part "], [1.050794, "content", "4: Long Context**\nAs"], [1.06932, "content", " context grows, latency"], [1.087675, "content", " is jointly"], [1.106262, "content", " determined by fixed weight reads and the"], [1.124652, "content", " ever"], [1.143474, "content", "-growing attention"], [1.161774, "content", " cache reads. Reports should provide"], [1.180217, "content", " absolute"], [1.199213, "content", " speed, relative retention rate"], [1.217486, "content", ", and actual"], [1.236104, "content", " prompt token count, while recording cache"], [1.254357, "content", " format, maximum capacity, sampler, and"], [1.272656, "content", " graph execution state.\n\n**Part "], [1.291758, "content", "5: Reproducibility**\nSt"], [1.310203, "content", "able inputs must be saved as the actual"], [1.328697, "content", " message files sent,"], [1.346768, "content", " with"], [1.365544, "content", " source and token count"], [1.384193, "content", " recorded. Formal runs must"], [1.402717, "content", " not temporarily download web pages, randomly select"], [1.421105, "content", " problems"], [1.439532, "content", ", or delete slower samples. Every"], [1.458252, "content", " number should"], [1.476627, "content", " be traceable back"], [1.495032, "content", " to a specific model, command, input"], [1.513552, "content", ", and service log.\n\n**Part"], [1.53208, "content", " 6: Interpretation of"], [1.550526, "content", " Results**\nA single isolated"], [1.568935, "content", " fastest run cannot prove stable performance, and"], [1.587243, "content", " a single high-"], [1.605941, "content", "acceptance-rate"], [1.624419, "content", " text cannot represent all output"], [1.642778, "content", " scenarios. Code, narrative, translation,"], [1.661321, "content", " and structured content have different token distributions and"], [1.679965, "content", " should be presented"], [1.698824, "content", " separately rather than blended"], [1.716924, "content", " into a meaningless overall"], [1.735483, "content", " average.\n\n---\n\n**"], [1.754005, "content", "Chinese-English Glossary**\n\n1"], [1.772754, "content", ". 运行边界 ("], [1.791188, "content", "y"], [1.80992, "content", "í"], [1.828451, "content", "ng xí"], [1.847054, "content", "ng bi"], [1.865529, "content", "ān jiè"], [1.884462, "content", ") –"], [1.902796, "content", " Operating Boundaries\n2. 活动"], [1.921266, "content", "请求 (hu"], [1.939975, "content", "ó"], [1.958753, "content", " dòng q"], [1.995818, "content", "ǐng qi"], [2.014374, "content", "ú"], [2.032969, "content", ")"], [2.051778, "content", " – Active Request"], [2.07153, "content", "\n3. 模型"], [2.090102, "content", "状态 (mó"], [2.108709, "content", " xí"], [2.127236, "content", "ng z"], [2.145891, "content", "hu"], [2.164645, "content", "àng"], [2.183198, "content", " tài"], [2.201598, "content", ") – Model State\n4. "], [2.220077, "content", "执行程序 (zh"], [2.23858, "content", "í"], [2.256838, "content", " xí"], [2.276257, "content", "ng ch"], [2.294993, "conte