rontier. Timing must distinguish"], [0.857499, "content", " between host preparation, visual preprocessing, text"], [0.875394, "content", " prefill, and the first output token"], [0.893321, "content", "; file"], [0.910866, "content", " I/O or"], [0.928783, "content", " model loading must not be included in throughput"], [0.946682, "content", " calculations"], [0.964587, "content", ".\n\n**Part 3: Dec"], [0.982277, "content", "oding**\nStandard"], [1.000218, "content", " decoding commits one token per iteration"], [1.017945, "content", ","], [1.035791, "content", " whereas speculative decoding can verify multiple candidates and"], [1.0538, "content", " commit a contiguous"], [1.071798, "content", " prefix. Regardless of the"], [1.08976, "content", " number of accepted"], [1.107636, "content", " candidates, the public output, KV cache"], [1.125431, "content", ", recurrent state, and counters must all"], [1.143488, "content", " align"], [1.161595, "content", " with the same committed position;"], [1.179691, "content", " no partially"], [1.197564, "content", " updated state is"], [1.215329, "content", " permitted.\n\n**Part 4:"], [1.233671, "content", " Long Context**\nAs context length"], [1.251647, "content", " grows, latency"], [1.269613, "content", " is jointly"], [1.287676, "content", " determined by fixed-weight"], [1.305698, "content", " reads and the"], [1.323984, "content", " ever"], [1.342109, "content", "-growing attention cache reads. Reports"], [1.360272, "content", " must present"], [1.378193, "content", " absolute"], [1.396507, "content", " speed, relative retention rate"], [1.414395, "content", ", and actual"], [1.432026, "content", " prompt token count, while also documenting"], [1.449803, "content", " cache format, maximum capacity, sampler configuration"], [1.468127, "content", ", and graph execution status"], [1.485821, "content", ".\n\n**Part 5: Rep"], [1.503782, "content", "roducibility**\nStable inputs must"], [1.521671, "content", " be saved as the"], [1.539668, "content", " actual message files sent,"], [1.557586, "content", " with"], [1.57528, "content", " their"], [1.593561, "content", " source and token counts recorded"], [1.611261, "content", ". Formal runs must"], [1.629208, "content", " not involve"], [1.647282, "content", " ad-h"], [1.664973, "content", "oc web downloads, random question"], [1.682887, "content", " selection, or exclusion"], [1.700765, "content", " of slower samples. Every"], [1.718993, "content", " reported"], [1.736988, "content", " number"], [1.755118, "content", " must be traceable back"], [1.772793, "content", " to a specific model, command, input"], [1.790734, "content", ", and service log"], [1.808604, "content", ".\n\n**Part 6: Interpre"], [1.82659, "content", "ting Results**\nA single isolated"], [1.84439, "content", " fastest run does"], [1.862251, "content", " not prove stable performance, and a single"], [1.88015, "content", " text"], [1.897781, "content", " with a"], [1.916133, "content", " high acceptance rate does not represent all output"], [1.933825, "content", " scenarios. Code, narrative, translation"], [1.951953, "content", ", and structured content exhibit"], [1.969842, "content", " different"], [1.987787, "content", " token distributions and should be presented separately rather"], [2.005917, "content", " than aggregated"], [2.023865, "content", " into a meaningless overall"], [2.041798, "content", " average.\n\n***"], [2.059792, "content", "\n\n**"], [2.077693, "content", "G"], [2.095723, "content", "lossary**\n\n1"], [2.113736, "content", ".  **运行边界** ("], [2.131608, "content", "Operational Boundaries):"], [2.149719, "content", " The defined"], [2.167722, "content", " limits"], [2.185717, "content", " and constraints within"], [2.203566, "content", " which the system operates."], [2.221713, "content", "\n2.  **活动"], [2.239674, "content", "请求** (Active Request): The"], [2.257795, "content", " single"], [2.275767, "content", " user"], [2.293682, "content", " que