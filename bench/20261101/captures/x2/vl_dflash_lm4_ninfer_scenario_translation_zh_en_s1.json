rocess"], [4.805454, "content", " and remember"], [4.823948, "content", " very"], [4.842278, "content", " long inputs"], [4.860857, "content", "."], [4.879631, "content", "\n21. **注意力"], [4.898184, "content", "缓存**"], [4.916712, "content", " (Attention Cache): Specifically"], [4.934894, "content", ", the cached"], [4.953655, "content", " keys and values"], [4.971862, "content", " used in the self"], [4.990587, "content", "-attention mechanism.\n22."], [5.0088, "content", " **相对保留率** (Relative Ret"], [5.027133, "content", "ention Rate): A"], [5.045611, "content", " metric comparing"], [5.064562, "content", " performance"], [5.082688, "content", " at"], [5.101004, "content", " a long"], [5.119633, "content", " context length"], [5.138239, "content", " to"], [5.156797, "content", " performance"], [5.175412, "content", " at a baseline short"], [5.193565, "content", " length"], [5.212031, "content", ".\n23. **可"], [5.230728, "content", "复现性** (Reproduc"], [5.248874, "content", "ibility): The ability to obtain"], [5.267353, "content", " the same results when"], [5.285809, "content", " the experiment"], [5.304009, "content", " is repeated under the same conditions.\n"], [5.322825, "content", "24. **采样"], [5.341406, "content", "器** (Sampler): The algorithm"], [5.359779, "content", " used to select"], [5.378042, "content", " the next token from the"], [5.396481, "content", " probability distribution (e.g., greedy,"], [5.415586, "content", " top"], [5.4339, "content", "-k,"], [5.452595, "content", " temperature"], [5.470859, "content", " sampling"], [5.489342, "content", ")."]], "usage": {"prompt_tokens": 401, "total_tokens": 1555, "completion_tokens": 1154, "completion_tokens_details": {"reasoning_tokens": 0}}, "finish": "stop", "ttft_s": 0.277946, "t_last_s": 5.489342, "t_end_s": 5.492420399968978, "completion_tokens": 1154, "decode_tok_s": 221.24590033073673, "captured": "2026-11-01 09:09:34"}